# ---- Supabase (NEW project for the product — never DORI's) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only secret, never NEXT_PUBLIC

# ---- Product identity ----
NEXT_PUBLIC_APP_NAME=RentFlow                       # your product name, shown in the admin + tabs
NEXT_PUBLIC_APP_URL=https://app.yourproduct.com     # this deployment's base URL (used for links/emails)

# ---- Email (new Resend account/key for the product) ----
RESEND_API_KEY=your-resend-key
# Optional: a verified sender once you set up a domain in Resend (otherwise a
# sandbox sender is used and only delivers to the Resend account's own address).
MAIL_FROM=RentFlow <bookings@yourproduct.com>
# Optional fallback recipient if a business has no email on file.
NOTIFY_EMAIL=

# NOTE: PUBLIC_BUSINESS_ID is NO LONGER USED — the product is multi-tenant and
# resolves each business from the /s/<slug> URL. Do not set it.

# ---- In-app support bubble (optional) ----
NEXT_PUBLIC_SUPPORT_WHATSAPP=        # digits only incl. country code, e.g. 38344123456
NEXT_PUBLIC_SUPPORT_EMAIL=           # e.g. suport@menaxhorentin.com

# UI language is chosen in-app (Settings) and stored in a cookie — no env needed.
# Default language is Albanian (sq), with an English (en) option.
